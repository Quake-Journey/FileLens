<Window x:Class="FileLens.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры FileLens" Width="620" Height="490" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" SourceInitialized="Window_SourceInitialized">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="Контекстное меню Windows" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="Проверяй файлы прямо из Проводника." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18">
      <StackPanel>
        <TextBlock Text="Проверить, кто держит файл" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="По нажатию файл сразу проверяется в FileLens. Если окно уже открыто, файл появится в нём." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" />
        <TextBlock x:Name="RegistrationStatus" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,16,0,0" />
        <TextBox x:Name="RegisteredPath" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0,5,0,0" FontSize="10" Foreground="{StaticResource Muted}" />
        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
          <Button x:Name="RegisterButton" Content="Добавить в меню" Style="{StaticResource PrimaryButton}" Click="Register_Click" Margin="0,0,10,0" />
          <Button x:Name="UnregisterButton" Content="Удалить из меню" Click="Unregister_Click" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Text="Для текущего пользователя, без прав администратора. Windows 11: пункт находится в «Показать дополнительные параметры». После перемещения EXE добавь пункт заново из его новой папки." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,15,0,0" />
  </Grid>
</Window>
