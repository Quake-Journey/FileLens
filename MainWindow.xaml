<Window x:Class="FileLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileLens — кто держит файл" Width="1120" Height="850" MinWidth="920" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop" SourceInitialized="Window_SourceInitialized">
  <Grid Margin="32,24,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,24">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="11" Background="#183831" Margin="0,0,12,0">
          <Viewbox Margin="8"><Canvas Width="24" Height="24"><Path Stroke="{StaticResource Accent}" StrokeThickness="1.8" Data="M 14,4 L 6,4 L 6,19 L 18,19 L 18,8 Z M 13,4 L 13,9 L 18,9" /><Ellipse Width="8" Height="8" Canvas.Left="12" Canvas.Top="12" Stroke="{StaticResource Accent}" StrokeThickness="2" Fill="#183831" /><Line X1="19" Y1="19" X2="23" Y2="23" Stroke="{StaticResource Accent}" StrokeThickness="2" /></Canvas></Viewbox>
        </Border>
        <TextBlock Text="FileLens" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text=" /  ФАЙЛЫ И ПРОЦЕССЫ" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,4,0,0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border CornerRadius="6" Background="#182337" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="WIN64" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" /></Border>
        <Button x:Name="SettingsButton" Content="Параметры" Padding="12,7" FontSize="11" Margin="0,0,8,0" Click="Settings_Click" />
        <Button x:Name="AdminButton" Content="Запустить от администратора" Padding="12,7" FontSize="11" Click="Admin_Click" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,0,0,22">
      <TextBlock Text="Кто держит этот файл?" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="Найди приложение, которое использует файл и может мешать его удалить." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
    </StackPanel>
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="ПУТЬ К ФАЙЛУ" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="PathBox" AutomationProperties.Name="Путь к файлу" KeyDown="Path_KeyDown" TextChanged="Path_Changed" HorizontalScrollBarVisibility="Hidden" AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop" />
            <TextBlock x:Name="PathPlaceholder" Text="Вставь путь, например C:\Program Files\…\RTSSHooks64.dll" Foreground="#667C99" FontSize="13" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <Button Grid.Column="1" x:Name="BrowseButton" Content="Выбрать файл…" Margin="10,0,0,0" Click="Browse_Click" />
          <Button Grid.Column="2" x:Name="ScanButton" Content="Найти процессы" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Scan_Click" MinWidth="160" />
        </Grid>
        <TextBlock Text="Можно перетащить файл сюда из Проводника. Enter — начать проверку." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,11,0,0" />
        <ProgressBar x:Name="ScanProgress" Visibility="Collapsed" Height="3" Margin="0,14,0,0" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="#26374B" BorderThickness="0" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="3" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="170" /><ColumnDefinition Width="16" /><ColumnDefinition Width="185" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14">
        <StackPanel><TextBlock Text="СОСТОЯНИЕ ФАЙЛА" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="StatusTitle" Text="Ожидает проверки" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" Foreground="{StaticResource Accent}" /><TextBlock x:Name="StatusDetail" Text="Выбери файл, чтобы увидеть результат" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14"><StackPanel><TextBlock Text="ПРОЦЕССОВ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ProcessCount" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0" /><TextBlock Text="используют файл" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel></Border>
      <Border Grid.Column="4" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,14"><StackPanel><TextBlock Text="ПОСЛЕДНЯЯ ПРОВЕРКА" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ScanTime" Text="—" FontSize="24" Margin="0,6,0,0" /><TextBlock x:Name="ScanDuration" Text="результат появится здесь" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="4">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,10">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Использующие процессы" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Действия с путём — для выбранной строки" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="RevealButton" Content="Расположение EXE" Padding="12,7" FontSize="11" Margin="0,0,8,0" IsEnabled="False" Click="Reveal_Click" ToolTip="Открыть EXE выбранного процесса в Проводнике" />
          <Button x:Name="CopyPathButton" Content="Копировать путь" Padding="12,7" FontSize="11" Margin="0,0,8,0" MinWidth="112" IsEnabled="False" Click="CopyPath_Click" ToolTip="Копировать полный путь к EXE выбранного процесса" />
          <Button x:Name="CopyButton" Content="Копировать отчёт" Padding="12,7" FontSize="11" IsEnabled="False" Click="Copy_Click" ToolTip="Копировать весь результат проверки" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
          <DataGrid x:Name="ProcessGrid" AutomationProperties.Name="Процессы, использующие файл" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionChanged="Process_SelectionChanged" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ПРОЦЕСС / СЛУЖБА" Width="230" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DescriptionLine}" ToolTip="{Binding DescriptionLine}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75" />
              <DataGridTextColumn Header="КАК ИСПОЛЬЗУЕТ" Binding="{Binding Usage}" Width="190" />
              <DataGridTemplateColumn Header="ПУТЬ К ПРОГРАММЕ" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DisplayPath}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,45,24,20" IsHitTestVisible="False">
            <TextBlock x:Name="EmptyIcon" Text="⌕" Foreground="{StaticResource Accent}" FontSize="42" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="Начни с выбора файла" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
            <TextBlock x:Name="EmptyDetail" Text="Здесь появятся приложения, службы и загруженные модули." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="540" Margin="0,9,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="5" x:Name="DetailPanel" Visibility="Collapsed" Background="#14232E" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
      <StackPanel><TextBlock x:Name="SelectedTitle" FontSize="12" FontWeight="SemiBold" /><TextBox x:Name="SelectedPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,5,0,0" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel>
    </Border>
    <Grid Grid.Row="6" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="Footer" Text="Процессы, допускающие удаление, тоже могут быть в списке. Проверка не удаляет файл." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,14,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="FILELENS  1.1.0" FontSize="10" Foreground="#607590" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
